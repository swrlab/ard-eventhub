								"type": "string",
								"pattern": "^urn:ard:(permanent-livestream|event-livestream):[a-z0-9]+$",
								"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"],
								"description": "Pre-encoded ARD livestream URN"
							},
							"publisherId": {
								"type": "string",
								"pattern": "^urn:ard:publisher:[a-z0-9]+$",
								"examples": ["urn:ard:publisher:75dbb3dace15f610"],
								"description": "Pre-encoded ARD publisher URN"
							},
							"institutionId": {
								"type": "string",
								"pattern": "^urn:ard:institution:[a-z0-9]+$",
								"examples": ["urn:ard:institution:a3004ff924ece1a2"],
								"description": "Owning institution URN (claim; validation checks it against the feed)"
							},
							"externalId": {
								"deprecated": true,
								"description": "Deprecated on Connect. Optional and ignored; still emitted by legacy ingest.",
								"examples": ["crid://swr.de/123450"],
								"type": "string"
							},
							"type": {
								"deprecated": true,
								"description": "Deprecated on Connect. Optional and ignored; still emitted by legacy ingest.",
								"examples": ["PermanentLivestream"],
								"type": "string",
								"enum": ["EventLivestream", "PermanentLivestream"]
							}
						},
						"required": ["id", "publisherId", "institutionId"],
						"additionalProperties": false
					}
				}
			},
			"validationFeedbackBody": {
				"type": "object",
				"properties": {
					"created": {
						"type": "string",
						"description": "Time of the rejection.",
						"examples": ["2020-01-19T06:00:00+01:00"]
					},
					"institutionId": {
						"type": "string",
						"pattern": "^urn:ard:institution:[a-z0-9]+$",
						"examples": ["urn:ard:institution:a3004ff924ece1a2"],
						"description": "Institution the inbox belongs to."
					},
					"subject": {
						"type": "string",
						"description": "Inbox subject the event arrived on (`inbox.{institutionId}`).",
						"examples": ["inbox.urn:ard:institution:a3004ff924ece1a2"]
					},
					"errors": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"path": {
									"type": "string",
									"description": "JSON path of the problem (`.body.services.0.id`).",
									"examples": [".body.title"]
								},
								"message": {
									"type": "string",
									"examples": ["should have required property 'title'"]
								},
								"errorCode": {
									"type": "string",
									"description": "Schema errors use `*.openapi.validation`. Ownership uses `unauthorized.eventhub.validation` or `notFound.eventhub.validation`.",
									"examples": ["required.openapi.validation"]
								}
							},
							"required": ["path", "message", "errorCode"],
							"additionalProperties": false
						},
						"description": "Same shape as `errors` on the HTTPS API 400 response. One entry per problem."
					},
					"playlistItemId": {
						"description": "Copied from the payload when present, so a track rejection can be correlated.",
						"examples": ["swr3-demo-1"],
						"type": "string"
					},
					"start": {
						"description": "Copied from the payload when present. Control and data correlate on this plus `subject`.",
						"examples": ["2026-10-08T12:00:00+02:00"],
						"type": "string"
					},
					"deprecated": {
						"description": "Deprecated `services[]` fields that were still sent (`services.externalId`, `services.type`).",
						"examples": [["services.externalId", "services.type"]],
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"event": {
						"description": "Rejected event as it arrived: a JSON value, otherwise text. Over 64 KiB this is `{ truncated, bytes, head }`."
					}
				},
				"required": ["created", "institutionId", "subject", "errors", "event"],
				"additionalProperties": false,
				"description": "Last rejection for one institution, retained on `feedback/{institutionId}`. An accepted event writes nothing here."
			}
		}
	}
}
