{
	"asyncapi": "3.0.0",
	"info": {
		"title": "ARD Eventhub Connect",
		"description": "MQTT 3.1.1 event contract for Eventhub Connect. Publishers send `track.playing`, `track.next`, `radio.control`, and `radio.data` to `inbox/{institutionId}` and subscribe to rejections on `feedback/{institutionId}`. Subscribers read the validated event on `radio/{livestreamId}/track/playing`, `…/track/next`, `…/control`, or `…/data`. TLS port 8883; configure `connect-bad`, `connect-stg`, and `connect-mnz` in the stage DNS. `radio.control` and `radio.data` are not accepted on the HTTPS `POST /events` API. The server host below is a placeholder; connection details are in the publisher migration guide.",
		"termsOfService": "https://www.ard.de",
		"contact": {
			"email": "lab@swr.de"
		},
		"license": {
			"name": "European Union Public License 1.2",
			"url": "https://spdx.org/licenses/EUPL-1.2.html"
		},
		"version": "3.0.0-beta.1",
		"externalDocs": {
			"description": "Eventhub v3 Connect RFC §6.2",
			"url": "https://swrlab.github.io/ard-eventhub/context-rfc/eventhub-v3-connect#62-topic-tree"
		}
	},
	"defaultContentType": "application/json",
	"servers": {
		"connect": {
			"host": "connect.eventhub.invalid",
			"protocol": "mqtt",
			"protocolVersion": "3.1.1",
			"description": "Placeholder host. Clients use mqtts on port 8883 against connect-bad, connect-stg, and connect-mnz in the stage DNS. MQTT 5 is rejected.",
			"security": [
				{
					"mqttUserPassword": []
				}
			]
		}
	},
	"channels": {
		"inboxInstitution": {
			"address": "inbox/{institutionId}",
			"title": "inbox/{institutionId}",
			"description": "Publisher write path for every event class. Eventhub validates the payload and republishes an accepted event onto `radio/{livestreamId}/…`. A rejection is retained on `feedback/{institutionId}`.",
			"parameters": {
				"institutionId": {
					"description": "Owning institution URN (`urn:ard:institution:…`). Must match the livestream.",
					"examples": ["urn:ard:institution:a3004ff924ece1a2"]
				}
			},
			"messages": {
				"radioTrackPlaying": {
					"$ref": "#/components/messages/radioTrackPlaying"
				},
				"radioTrackNext": {
					"$ref": "#/components/messages/radioTrackNext"
				},
				"radioControl": {
					"$ref": "#/components/messages/radioControl"
				},
				"radioData": {
					"$ref": "#/components/messages/radioData"
				}
			}
		},
		"radioLivestreamTrackPlaying": {
			"address": "radio/{livestreamId}/track/playing",
			"title": "radio/{livestreamId}/track/playing",
			"description": "Validation output. Retained so a late joiner sees the current now-playing item. QoS 1.",
			"parameters": {
				"livestreamId": {
					"description": "Livestream URN (`urn:ard:permanent-livestream:…` or `urn:ard:event-livestream:…`)",
					"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"]
				}
			},
			"messages": {
				"radioTrackPlaying": {
					"$ref": "#/components/messages/radioTrackPlaying"
				}
			}
		},
		"radioLivestreamTrackNext": {
			"address": "radio/{livestreamId}/track/next",
			"title": "radio/{livestreamId}/track/next",
			"description": "Validation output. Retained latest planned next item. QoS 1.",
			"parameters": {
				"livestreamId": {
					"description": "Livestream URN (`urn:ard:permanent-livestream:…` or `urn:ard:event-livestream:…`)",
					"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"]
				}
			},
			"messages": {
				"radioTrackNext": {
					"$ref": "#/components/messages/radioTrackNext"
				}
			}
		},
		"radioLivestreamControl": {
			"address": "radio/{livestreamId}/control",
			"title": "radio/{livestreamId}/control",
			"description": "Validation output. Retained so a late joiner sees the current control bits. QoS 1, durable.",
			"parameters": {
				"livestreamId": {
					"description": "Livestream URN (`urn:ard:permanent-livestream:…` or `urn:ard:event-livestream:…`)",
					"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"]
				}
			},
			"messages": {
				"radioControl": {
					"$ref": "#/components/messages/radioControl"
				}
			}
		},
		"radioLivestreamData": {
			"address": "radio/{livestreamId}/data",
			"title": "radio/{livestreamId}/data",
			"description": "Validation output. Cyclic radiotext / dynamic label / RT+. Retained as the latest cycle. QoS 1.",
			"parameters": {
				"livestreamId": {
					"description": "Livestream URN (`urn:ard:permanent-livestream:…` or `urn:ard:event-livestream:…`)",
					"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"]
				}
			},
			"messages": {
				"radioData": {
					"$ref": "#/components/messages/radioData"
				}
			}
		},
		"feedbackInstitution": {
			"address": "feedback/{institutionId}",
			"title": "feedback/{institutionId}",
			"description": "Publisher diagnostic. The last rejection for this institution, retained. Not an acknowledgement: an accepted event writes nothing here. QoS 1.",
			"parameters": {
				"institutionId": {
					"description": "Owning institution URN (`urn:ard:institution:…`). Must match the livestream.",
					"examples": ["urn:ard:institution:a3004ff924ece1a2"]
				}
			},
			"messages": {
				"validationFeedback": {
					"$ref": "#/components/messages/validationFeedback"
				}
			}
		}
	},
	"operations": {
		"sendRadioTrackPlaying": {
			"action": "send",
			"title": "Publish track.playing on inbox/{institutionId}",
			"description": "Publish a now-playing item to the institution inbox. Event type: [de.ard.eventhub.v1.radio.track.playing](/event/radio.track.playing).",
			"channel": {
				"$ref": "#/channels/inboxInstitution"
			},
			"messages": [
				{
					"$ref": "#/channels/inboxInstitution/messages/radioTrackPlaying"
				}
			],
			"tags": [
				{
					"name": "publish"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": false
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.track.playing",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.track.playing"
			}
		},
		"sendRadioTrackNext": {
			"action": "send",
			"title": "Publish track.next on inbox/{institutionId}",
			"description": "Publish a planned next item to the institution inbox. Event type: [de.ard.eventhub.v1.radio.track.next](/event/radio.track.next).",
			"channel": {
				"$ref": "#/channels/inboxInstitution"
			},
			"messages": [
				{
					"$ref": "#/channels/inboxInstitution/messages/radioTrackNext"
				}
			],
			"tags": [
				{
					"name": "publish"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": false
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.track.next",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.track.next"
			}
		},
		"sendRadioControl": {
			"action": "send",
			"title": "Publish radio.control on inbox/{institutionId}",
			"description": "Publish a control-bit change to the institution inbox. Not accepted on HTTPS `POST /events`. Event type: [de.ard.eventhub.v1.radio.control](/event/radio.control).",
			"channel": {
				"$ref": "#/channels/inboxInstitution"
			},
			"messages": [
				{
					"$ref": "#/channels/inboxInstitution/messages/radioControl"
				}
			],
			"tags": [
				{
					"name": "publish"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": false
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.control",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.control"
			}
		},
		"sendRadioData": {
			"action": "send",
			"title": "Publish radio.data on inbox/{institutionId}",
			"description": "Publish a cyclic radiotext / RT+ bundle to the institution inbox. Not accepted on HTTPS `POST /events`. Event type: [de.ard.eventhub.v1.radio.data](/event/radio.data).",
			"channel": {
				"$ref": "#/channels/inboxInstitution"
			},
			"messages": [
				{
					"$ref": "#/channels/inboxInstitution/messages/radioData"
				}
			],
			"tags": [
				{
					"name": "publish"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": false
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.data",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.data"
			}
		},
		"receiveRadioTrackPlaying": {
			"action": "receive",
			"title": "Subscribe radio/{livestreamId}/track/playing",
			"description": "Validated now-playing item for one livestream. Retained; QoS 1. The livestream URN is `services[].id`. Event type: [de.ard.eventhub.v1.radio.track.playing](/event/radio.track.playing).",
			"channel": {
				"$ref": "#/channels/radioLivestreamTrackPlaying"
			},
			"messages": [
				{
					"$ref": "#/channels/radioLivestreamTrackPlaying/messages/radioTrackPlaying"
				}
			],
			"tags": [
				{
					"name": "subscribe"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": true
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.track.playing",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.track.playing"
			}
		},
		"receiveRadioTrackNext": {
			"action": "receive",
			"title": "Subscribe radio/{livestreamId}/track/next",
			"description": "Validated next item for one livestream. Retained; QoS 1. The livestream URN is `services[].id`. Event type: [de.ard.eventhub.v1.radio.track.next](/event/radio.track.next).",
			"channel": {
				"$ref": "#/channels/radioLivestreamTrackNext"
			},
			"messages": [
				{
					"$ref": "#/channels/radioLivestreamTrackNext/messages/radioTrackNext"
				}
			],
			"tags": [
				{
					"name": "subscribe"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": true
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.track.next",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.track.next"
			}
		},
		"receiveRadioControl": {
			"action": "receive",
			"title": "Subscribe radio/{livestreamId}/control",
			"description": "Validated control bits for one livestream. Retained; QoS 1. Event type: [de.ard.eventhub.v1.radio.control](/event/radio.control).",
			"channel": {
				"$ref": "#/channels/radioLivestreamControl"
			},
			"messages": [
				{
					"$ref": "#/channels/radioLivestreamControl/messages/radioControl"
				}
			],
			"tags": [
				{
					"name": "subscribe"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": true
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.control",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.control"
			}
		},
		"receiveRadioData": {
			"action": "receive",
			"title": "Subscribe radio/{livestreamId}/data",
			"description": "Validated radiotext / dynamic label / RT+ for one livestream. Retained latest cycle; QoS 1. Event type: [de.ard.eventhub.v1.radio.data](/event/radio.data).",
			"channel": {
				"$ref": "#/channels/radioLivestreamData"
			},
			"messages": [
				{
					"$ref": "#/channels/radioLivestreamData/messages/radioData"
				}
			],
			"tags": [
				{
					"name": "subscribe"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": true
				}
			},
			"externalDocs": {
				"description": "de.ard.eventhub.v1.radio.data",
				"url": "https://swrlab.github.io/ard-eventhub/event/radio.data"
			}
		},
		"receiveFeedback": {
			"action": "receive",
			"title": "Subscribe feedback/{institutionId}",
			"description": "Last rejection for this institution. Correlate track events by `playlistItemId`, control and data by `start`. Retained; QoS 1.",
			"channel": {
				"$ref": "#/channels/feedbackInstitution"
			},
			"messages": [
				{
					"$ref": "#/channels/feedbackInstitution/messages/validationFeedback"
				}
			],
			"tags": [
				{
					"name": "subscribe"
				}
			],
			"bindings": {
				"mqtt": {
					"qos": 1,
					"retain": true
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"mqttUserPassword": {
				"type": "userPassword",
				"description": "MQTT username and password issued for Eventhub Connect. Replaces the HTTPS Bearer token."
			}
		},
		"messages": {
			"radioTrackPlaying": {
				"name": "de.ard.eventhub.v1.radio.track.playing",
				"title": "track.playing",
				"summary": "Now-playing item. Retained on `radio/{livestreamId}/track/playing` after validation.",
				"contentType": "application/json",
				"payload": {
					"$ref": "#/components/schemas/connectInboxTrackPlaying"
				}
			},
			"radioTrackNext": {
				"name": "de.ard.eventhub.v1.radio.track.next",
				"title": "track.next",
				"summary": "Planned next item. Retained on `radio/{livestreamId}/track/next` after validation.",
				"contentType": "application/json",
				"payload": {
					"$ref": "#/components/schemas/connectInboxTrackNext"
				}
			},
			"radioControl": {
				"name": "de.ard.eventhub.v1.radio.control",
				"title": "radio.control",
				"summary": "Control bits (TA, TP, EON, Regio, …). `name` is a free string, not an enum.",
				"contentType": "application/json",
				"payload": {
					"$ref": "#/components/schemas/eventV1RadioControlPostBody"
				}
			},
			"radioData": {
				"name": "de.ard.eventhub.v1.radio.data",
				"title": "radio.data",
				"summary": "Cyclic radiotext, dynamic label, and RT+/DL+ bundle.",
				"contentType": "application/json",
				"payload": {
					"$ref": "#/components/schemas/eventV1RadioDataPostBody"
				}
			},
			"validationFeedback": {
				"name": "feedback",
				"title": "feedback",
				"summary": "Last rejection for one institution. Not an acknowledgement: a successful publish writes nothing here.",
				"contentType": "application/json",
				"payload": {
					"$ref": "#/components/schemas/validationFeedbackBody"
				}
			}
		},
		"schemas": {
			"servicesUrn": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^urn:ard:(permanent-livestream|event-livestream):[a-z0-9]+$",
						"examples": ["urn:ard:permanent-livestream:49267f7d67be180d"],
						"description": "Pre-encoded ARD livestream URN"
					},
					"publisherId": {
						"type": "string",
						"pattern": "^urn:ard:publisher:[a-z0-9]+$",
						"examples": ["urn:ard:publisher:75dbb3dace15f610"],
						"description": "Pre-encoded ARD publisher URN"
					},
					"institutionId": {
						"type": "string",
						"pattern": "^urn:ard:institution:[a-z0-9]+$",
						"examples": ["urn:ard:institution:a3004ff924ece1a2"],
						"description": "Owning institution URN (claim; validation checks it against the feed)"
					},
					"externalId": {
						"deprecated": true,
						"description": "Deprecated on Connect. Optional and ignored; still emitted by legacy ingest.",
						"examples": ["crid://swr.de/123450"],
						"type": "string"
					},
					"type": {
						"deprecated": true,
						"description": "Deprecated on Connect. Optional and ignored; still emitted by legacy ingest.",
						"examples": ["PermanentLivestream"],
						"type": "string",
						"enum": ["EventLivestream", "PermanentLivestream"]
					}
				},
				"required": ["id", "publisherId", "institutionId"],
				"additionalProperties": false
			},
			"connectInboxTrackPlaying": {
				"type": "object",
				"properties": {
					"type": {
						"description": "The type of the element that triggered this event. See additional file in docs for details.",
						"examples": ["music"],
						"type": "string",
						"enum": ["audio", "commercial", "jingle", "live", "music", "news", "traffic", "weather"]
					},
					"start": {
						"type": "string",
						"description": "ISO8601 compliant timestamp",
						"examples": ["2020-01-19T06:00:00+01:00"]
					},
					"length": {
						"type": "number",
						"exclusiveMinimum": 0,
						"description": "Estimated length of the element in seconds. Must be set to a positive number (not 0 or null). The end of the current element is defined by the start of the next element.",
						"examples": [240]
					},
					"title": {
						"type": "string",
						"description": "Representative title for external use",
						"examples": ["Song name"]
					},
					"artist": {
						"description": "Pre-formatted artist information",
						"examples": ["Sam Feldt feat. Someone Else"],
						"type": ["string", "null"]
					},
					"contributors": {
						"description": "Full details about involved artists if available",
						"anyOf": [
							{
								"type": "array",
								"items": {
									"$ref": "#/definitions/contributor"
								}
							},
							{
								"type": "null"
							}
						]
					},
					"references": {
						"description": "related external entities",
						"anyOf": [
							{
								"type": "array",
								"items": {
									"$ref": "#/definitions/reference"
								}
							},
							{
								"type": "null"
							}
						]
					},
					"playlistItemId": {
						"type": "string",
						"description": "Unique identifier (within a publisher) to connect next and playing items if needed",
						"examples": ["swr3-5678"]
					},
					"hfdbIds": {
						"description": "Can reference all available tracks in ARD HFDB instances. Should ideally at least include the common ZSK instance.",
						"examples": [["swrhfdb1.KONF.12345", "zskhfdb1.KONF.12345"]],
						"anyOf": [
							{
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							{
								"type": "null"
							}
						]
					},
					"externalId": {
						"description": "Can reference the original ID in the publisher's system",
						"examples": ["M012345.001"],
						"type": ["string", "null"]
					},
					"isrc": {
						"description": "Appropriate ISRC code if track is a music element",
						"examples": ["DE012345678"],
						"type": ["string", "null"]
					},
					"upc": {
						"description": "Corresponding reference to an album where such ISRC was published",
						"type": ["string", "null"]
					},
					"mpn": {
						"description": "If available the reference to the original delivery from MPN",
						"type": ["string", "null"]
					},
					"media": {
						"description": "Can contain an array of media files like cover, artist, etc.",
						"anyOf": [
							{
								"type": "array",
								"items": {
									"$ref": "#/definitions/mediaItem"
								}
							},
							{
								"type": "null"
							}
						]
					},
					"plugins": {
						"description": "Highly optional field for future third-party metadata distribution or other connected services",
						"anyOf": [
							{
								"type": "array",
								"items": {
									"$ref": "#/definitions/eventPlugin"
								}
							},
							{
								"type": "null"
							}
						]
					},
					"creator": {
						"type": "string",
						"minLength": 1,
						"description": "Person or system that created the event, set by the publisher (for example an email address or the playout system)",
						"examples": ["example@swr.de"]
					},
					"created": {
						"type": "string",
						"description": "Set by Eventhub validation to the time of delivery. A value sent by the publisher is replaced.",
						"examples": ["2026-10-08T10:00:01.000Z"],
						"readOnly": true
					},
					"event": {
						"type": "string",
						"const": "de.ard.eventhub.v1.radio.track.playing",
						"description": "Event class. It selects the `radio/` topic after validation.",
						"examples": ["de.ard.eventhub.v1.radio.track.playing"]
					},
					"id": {
						"description": "Optional id supplied by the publisher. Connect does not assign one.",
						"examples": ["1234567890"],
						"type": "string"
					},
					"services": {
						"minItems": 1,
						"type": "array",
						"items": {
							"$ref": "#/definitions/servicesUrn"
						},
						"description": "URN-only service identifiers. `id` is the livestream URN used in the `radio/` topic."
					}
				},
				"required": ["type", "start", "length", "title", "playlistItemId", "creator", "created", "event", "services"],
				"additionalProperties": false,
				"description": "Now-playing item on Eventhub Connect. URN-only `services[]`. `created` is the delivery time.",
				"definitions": {
					"contributor": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string",
								"examples": ["Sam Feldt"]
							},
							"role": {
								"examples": ["artist"],
								"type": "string",
								"enum": [
									"artist",
									"author",
									"composer",
									"performer",
									"conductor",
									"choir",
									"leader",
									"ensemble",
									"orchestra",
									"soloist",
