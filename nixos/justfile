# NixOS commands run ON a host — uploaded to /etc/nixos/ by `just nix-upload`
# (local sync commands live in just/nixos.just in the repo).
# Run from the host: `cd /etc/nixos && just <recipe>`. Recipes default to the
# friendly name from /etc/nixos/hosts: hostname -s is the server number after
# the first switch, and may still be the friendly name before it.

# list all recipes
default:
	just --list

# flake attribute for this machine; either column of /etc/nixos/hosts matches
host := `awk -v n="$(hostname -s)" '$1 == n { print $1; f=1; exit } $2 == n { print $1; f=1; exit } END { if (!f) print n }' /etc/nixos/hosts`

# ── rebuild (confirm-gated) ──────────────────────────────────────────

# apply the uploaded config: nixos-rebuild switch
[confirm]
[group('NIXOS')]
flake host=host:
	nixos-rebuild switch --flake /etc/nixos#{{ host }}

# roll back to the previous generation
[confirm]
[group('NIXOS')]
rollback host=host:
	nixos-rebuild switch --rollback --flake /etc/nixos#{{ host }}

# update nixpkgs via flake update, then rebuild
[confirm]
[group('NIXOS')]
upgrade host=host:
	cd /etc/nixos && nix flake update
	nixos-rebuild switch --flake /etc/nixos#{{ host }}

# garbage-collect old generations
[confirm]
[group('NIXOS')]
clean:
	nix-collect-garbage -d

# ── inspection ───────────────────────────────────────────────────────

# build this host's config without activating it (nothing applied)
[group('NIXOS')]
dry host=host:
	nixos-rebuild dry-build --flake /etc/nixos#{{ host }}

# evaluate the flake (no build, nothing applied)
[group('NIXOS')]
check:
	nix flake check --impure /etc/nixos

# check the NTP time status
[group('NIXOS')]
ntp:
	timedatectl status
	timedatectl timesync-status
