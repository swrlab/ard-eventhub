{
	"name": "ard-eventhub",
	"version": "2.4.0",
	"description": "ARD system to distribute real-time (live) metadata for primarily radio broadcasts.",
	"keywords": [
		"ard",
		"metadata",
		"pubsub"
	],
	"license": "EUPL-1.2",
	"author": "SWR Audio Lab <lab@swr.de>",
	"type": "module",
	"main": "./src/ingest/index.ts",
	"imports": {
		"#config": "./src/config.ts",
		"#env": "./src/env.ts",
		"#types": "./src/types/index.ts"
	},
	"scripts": {
		"check": "oxlint && oxfmt --check",
		"check:fix": "oxlint --fix && oxfmt",
		"checks": "bun --parallel check typecheck knip",
		"coreId": "bun run ./src/cli/core-id.ts",
		"docker:build": "docker build . -t swr/ard-eventhub",
		"docker:clean": "docker rm ard-eventhub",
		"docker:run": "docker run --env-file .env -p 8080:8080 --name ard-eventhub swr/ard-eventhub",
		"docker:scan": "bun docker:build && docker scout quickview",
		"docs:build": "blume build",
		"docs:dev": "blume dev",
		"docs:preview": "blume preview",
		"feed": "bun run ./src/cli/feed.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"ingest": "bun run --hot ./src/ingest/index.ts",
		"knip": "knip",
		"license": "bunx license-compliance -f json -r detailed",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"openapi:format": "oxfmt openapi.json openapi.yaml",
		"test": "bun test --timeout 120000",
		"typecheck": "tsgo"
	},
	"dependencies": {
		"@frytg/check-required-env": "npm:@jsr/frytg__check-required-env",
		"@frytg/dates": "npm:@jsr/frytg__dates",
		"@frytg/logger": "npm:@jsr/frytg__logger",
		"@google-cloud/datastore": "^10.1.0",
		"@google-cloud/pubsub": "^5.3.0",
		"@swrlab/utils": "^2.2.0",
		"compression": "^1.8.1",
		"dd-trace": "^5.102.0",
		"express": "^4.22.2",
		"express-openapi-validator": "^5.6.2",
		"firebase-admin": "^13.9.0",
		"google-auth-library": "^10.6.2",
		"jsonwebtoken": "^9.0.3",
		"slug": "^11.0.1",
		"typescript": "^5.9.3",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"@types/compression": "^1.8.1",
		"@types/dd-trace": "^0.9.3",
		"@types/express": "^5.0.6",
		"@types/node": "^25.3.2",
		"@types/slug": "^5.0.9",
		"@types/supertest": "^6.0.3",
		"@typescript/native-preview": "^7.0.0-dev.20260227.1",
		"blume": "1.3.1",
		"cookie": "2.0.1",
		"knip": "^5.85.0",
		"license-compliance": "^3.0.1",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.77.0",
		"supertest": "^7.2.2"
	},
	"resolutions": {
		"@scalar/schemas": "0.8.0",
		"@scalar/types": "0.17.0",
		"ansi-regex": "^5.0.1",
		"got": "^11.8.6",
		"strip-ansi": "^6.0.1",
		"update-notifier": "^5.1.0"
	},
	"engines": {
		"bun": ">=1.3.9",
		"node": "^22.18.0 || >= 24.13.0",
		"npm": ">=11.5.1"
	},
	"packageManager": "bun@1.3.9",
	"knip": {
		"entry": [
			"blume.config.ts!"
		],
		"ignoreDependencies": [
			"cookie"
		]
	}
}
