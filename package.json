{
	"name": "ard-eventhub",
	"version": "3.0.0-beta.2",
	"description": "ARD system to distribute real-time (live) metadata for primarily radio broadcasts.",
	"keywords": [
		"ard",
		"metadata",
		"pubsub"
	],
	"license": "MIT",
	"author": "SWR Audio Lab <lab@swr.de>",
	"type": "module",
	"main": "./src/ingest/server.ts",
	"imports": {
		"#config": "./src/config.ts",
		"#env": "./src/env.ts",
		"#types": "./src/types/index.ts"
	},
	"scripts": {
		"docker:build": "docker build . -t swr/ard-eventhub",
		"docker:clean": "docker rm ard-eventhub",
		"docker:run": "docker run --env-file .env -p 8080:8080 --name ard-eventhub swr/ard-eventhub",
		"docker:scan": "bun docker:build && docker scout quickview",
		"format:check": "oxfmt --check",
		"ingest": "bun run --hot ./src/ingest/server.ts",
		"start": "bun ./src/ingest/server.ts"
	},
	"dependencies": {
		"@frytg/check-required-env": "npm:@jsr/frytg__check-required-env@0.2.0",
		"@frytg/dates": "npm:@jsr/frytg__dates@0.3.0",
		"@frytg/logger": "npm:@jsr/frytg__logger@0.0.3",
		"@google-cloud/datastore": "^11.3.1",
		"@google-cloud/pubsub": "^6.3.2",
		"@hono/bun": "^1.0.1",
		"@modelcontextprotocol/server": "^2.4.0",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/nats-core": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"@swrlab/utils": "^2.2.0",
		"firebase-admin": "^14.5.0",
		"google-auth-library": "^11.3.2",
		"hono": "^4.13.14",
		"jsonwebtoken": "^9.0.3",
		"mqtt": "^5.16.1",
		"slug": "^12.0.1",
		"ulid": "^3.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cross/test": "npm:@jsr/cross__test",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@modelcontextprotocol/client": "^2.4.0",
		"@std/assert": "npm:@jsr/std__assert",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/sinon": "^22.0.2",
		"@types/slug": "^5.0.9",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-vue": "6.0.10",
		"blume": "^2.2.6",
		"cookie": "^2.0.1",
		"knip": "^6.44.0",
		"license-compliance": "^4.0.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"sinon": "^22.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0"
	},
	"resolutions": {
		"@scalar/schemas": "0.8.0",
		"@scalar/types": "0.17.0",
		"ansi-regex": "^5.0.1",
		"got": "^11.8.6",
		"strip-ansi": "^6.0.1",
		"update-notifier": "^5.1.0"
	},
	"engines": {
		"bun": ">=1.3.9",
		"node": "^22.19.0 || >= 24.13.0",
		"npm": ">=11.5.1"
	},
	"packageManager": "bun@1.3.9",
	"knip": {
		"entry": [
			"blume.config.ts!",
			"src/cli/*.ts",
			"src/connect/index.ts",
			"vite.config.ts",
			"src/openapi/generate.ts",
			"src/asyncapi/generate.ts",
			"src/**/*.test.ts"
		],
		"ignoreDependencies": [
			"cookie",
			"@typescript/native-preview"
		],
		"ignore": [
			"src/connect/ui/client/**"
		]
	}
}
